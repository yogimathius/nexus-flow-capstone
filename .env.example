# Nexus Flow Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# NEXUS CORE (Backend API Server)
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/nexus_core

# AI Service Configuration
# Set one provider key to enable interpretations; without one, the API returns 503.
# OPENROUTER_API_KEY=your_real_key
# GITHUB_TOKEN=your_real_token

# Server Configuration
PORT=3003
RUST_LOG=info

# MCP Integration
ENABLE_MCP=true
MCP_TRANSPORT=stdio
SYMBOLS_MCP_ENTRY=/absolute/path/to/symbols-awakening-mcp/dist/index.js
SYMBOLS_MCP_DEMO=true
# For a persistent Symbols Awakening database, set SYMBOLS_MCP_DEMO=false and:
# SYMBOLS_MCP_DATABASE_URL=postgresql://username:password@localhost:5432/symbols_awakening
# Legacy Rust MCP over SSE: set MCP_TRANSPORT=sse and MCP_SERVER_URL=http://localhost:3002/sse

# =============================================================================
# LEGACY RUST SYMBOL ONTOLOGY (optional SSE server)
# =============================================================================

# Symbol Database Configuration
SYMBOL_DB_URL=postgresql://username:password@localhost:5432/symbol_ontology

# MCP Server Configuration
MCP_PORT=3002

# =============================================================================
# NEXUS WEB (Frontend)
# =============================================================================

# API Configuration
API_URL=http://localhost:3003/api

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# Run PostgreSQL, then follow README.md to build the sibling TypeScript MCP and start
# the Rust API and Leptos frontend. The API creates nexus_core when the role permits.
