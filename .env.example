# Nexus Flow Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# NEXUS CORE (Backend API Server)
# =============================================================================

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/nexus_core

# AI Service Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
GITHUB_TOKEN=your_github_token_here  # Optional, for Azure AI API fallback

# Server Configuration
PORT=3003
RUST_LOG=info

# MCP Integration
ENABLE_MCP=true
MCP_SERVER_URL=http://localhost:3002/sse

# =============================================================================
# SYMBOL ONTOLOGY (MCP Server)
# =============================================================================

# Symbol Database Configuration
SYMBOL_DB_URL=postgresql://username:password@localhost:5432/symbol_ontology

# MCP Server Configuration
MCP_PORT=3002

# =============================================================================
# NEXUS WEB (Frontend)
# =============================================================================

# API Configuration
API_URL=http://localhost:3003

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# 1. Create PostgreSQL databases:
#    createdb nexus_core
#    createdb symbol_ontology

# 2. Get OpenRouter API key from: https://openrouter.ai

# 3. GitHub token is optional but recommended for AI fallback:
#    https://github.com/settings/tokens

# 4. For production, update URLs to your deployed endpoints

# 5. Ensure PostgreSQL is running before starting services 