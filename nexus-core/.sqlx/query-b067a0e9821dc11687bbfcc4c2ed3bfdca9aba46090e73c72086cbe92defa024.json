{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT d.id, d.text, d.interpretation, d.created_at, \n                   array_agg(dt.tag) FILTER (WHERE dt.tag IS NOT NULL) as tags\n            FROM dreams d\n            LEFT JOIN dream_tags dt ON d.id = dt.dream_id\n            WHERE d.id = $1\n            GROUP BY d.id\n            ",
